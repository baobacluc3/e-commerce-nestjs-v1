NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ecommerce:local_dev_only@localhost:5432/ecommerce
LOG_LEVEL=info

# Auth. JWT_ACCESS_SECRET must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-local-dev-only-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Stripe Payment Provider (test mode)
STRIPE_SECRET_KEY=sk_test_local_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_local_placeholder

# Redis & BullMQ Async Backbone (Phase 13)
REDIS_URL=redis://localhost:6379
ORDER_EXPIRY_DELAY_MS=1800000
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_DELAY_MS=1000

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
REDIS_PORT=6379
