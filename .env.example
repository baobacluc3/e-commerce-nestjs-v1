NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ecommerce:local_dev_only@localhost:5432/ecommerce
LOG_LEVEL=info

# Auth. JWT_ACCESS_SECRET must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-local-dev-only-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
